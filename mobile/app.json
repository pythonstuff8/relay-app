{
  "expo": {
    "name": "Relay",
    "slug": "relay-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "relay",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D0D0F",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.suhaan.relay",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Relay uses the camera to describe your surroundings, read text aloud, find lost objects, scan the pairing code from the Relay desktop app, and flash the light for Night Guard alarms. Photos are sent to OpenAI only when you ask for help.",
        "NSMicrophoneUsageDescription": "Relay uses the microphone for live captions, voice questions, Remote Mic, and loud sound alerts. Speech is sent to Deepgram for transcription only while captions or the talk button are on.",
        "NSLocalNetworkUsageDescription": "Relay connects to the Relay desktop app on your Wi-Fi to receive sound alerts and captions and to send Remote Mic audio.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeAudioData",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.suhaan.relay",
      "adaptiveIcon": {
        "backgroundColor": "#D2DCF8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "VIBRATE",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "./plugins/withoutBackgroundModes",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D0D0F"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Relay uses the camera to describe your surroundings, read text aloud, find lost objects, scan the pairing code from the Relay desktop app, and flash the light for Night Guard alarms. Photos are sent to OpenAI only when you ask for help.",
          "barcodeScannerEnabled": true
        }
      ],
      "@saltmango/expo-audio-stream",
      [
        "expo-audio",
        {
          "microphonePermission": "Relay uses the microphone for live captions, voice questions, Remote Mic, and loud sound alerts. Speech is sent to Deepgram for transcription only while captions or the talk button are on.",
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "908fdeb2-164b-4e97-97ad-0586847ee006"
      }
    },
    "owner": "suhaanthayyil"
  }
}
