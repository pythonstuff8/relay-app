# Relay desktop development settings.
# Packaged builds never include keys: they use the Relay API proxy.
# Copy this file to .env for local development only.

# Optional: call providers directly while developing (never shipped).
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Optional: point at a different Relay API deployment (default https://relay.suhaanthayyil.com/api).
RELAY_API_BASE=

# Optional: set to 1 to use the proxy even when local keys are present.
RELAY_FORCE_PROXY=
